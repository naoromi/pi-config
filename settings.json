{
  "packages": [
    "git:github.com/amosblomqvist/pi-interactive-subagents",
    "git:github.com/amosblomqvist/pi-observational-memory",
    "npm:pi-package-manager"
  ],
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "observational-memory": {
    "chunkTokens": 5000,
    "chunkOverlapTokens": 0,
    "poolTargetTokens": 10000,
    "consolidateAtPoolTokens": 20000,
    "compactAtContextTokens": 100000,
    "tailTokens": 20000,
    "journeyTargetTokens": 1000,
    "observerConcurrency": 4,
    "models": {
      "observer": {
        "provider": "openai-codex",
        "id": "gpt-5.6-terra",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "openai-codex",
        "id": "gpt-5.6-terra",
        "thinking": "medium"
      }
    },
    "passive": false,
    "debugLog": false
  },
  "hideThinkingBlock": false
}